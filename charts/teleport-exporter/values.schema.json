{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "teleport", "tbot", "controller", "service"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "teleport": {
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "clusterName": { "type": "string" },
        "insecure": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "listenAddress": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "collectTimeout": { "type": "string" }
      }
    },
    "tbot": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "token": { "type": "string" },
        "certificateTTL": { "type": "string" },
        "renewalInterval": { "type": "string" },
        "serviceAccountTokenExpirationSeconds": { "type": "integer", "minimum": 600 },
        "diag": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "startupProbe": { "$ref": "#/definitions/probe" },
        "livenessProbe": { "$ref": "#/definitions/probe" },
        "readinessProbe": { "$ref": "#/definitions/probe" },
        "resources": { "type": "object" },
        "extraEnv": { "type": "array" }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "annotations": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "updateStrategy": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "extraArgs": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "httpGet": {
          "type": "object",
          "required": ["path", "port"],
          "properties": {
            "path": { "type": "string" },
            "port": { "type": ["string", "integer"] }
          }
        },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
